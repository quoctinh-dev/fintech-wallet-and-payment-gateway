# ==============================================================================
# WALLET-AUTH ENVIRONMENT TEMPLATE (.env.example)
# ==============================================================================

# Server Port
PORT=8081

# Redis Configuration (Token Blacklist & Caching)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Database Configuration (PostgreSQL 15)
DB_HOST=localhost
DB_PORT=15433
DB_NAME=wallet_auth_db
DB_USERNAME=postgres
DB_PASSWORD=your_postgres_password_here

# Kafka Message Broker
KAFKA_BOOTSTRAP_SERVERS=localhost:9094

# JWT Security Configuration
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250655368566D5971
JWT_EXPIRATION=86400000

# Eureka Service Discovery
EUREKA_SERVER_URL=http://localhost:8761/eureka/
