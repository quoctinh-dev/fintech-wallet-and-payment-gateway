# ==============================================================================
# WALLET-LEDGER ENVIRONMENT TEMPLATE (.env.example)
# ==============================================================================

# Server REST & gRPC Ports
PORT=8083
GRPC_PORT=9093

# Database Configuration (PostgreSQL 15)
DB_HOST=localhost
DB_PORT=15433
DB_NAME=wallet_ledger_db
DB_USERNAME=postgres
DB_PASSWORD=your_postgres_password_here

# Redis Cache
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Eureka Service Discovery
EUREKA_SERVER_URL=http://localhost:8761/eureka/
