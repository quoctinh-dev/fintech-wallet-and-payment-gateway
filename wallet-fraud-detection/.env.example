# ==============================================================================
# WALLET-FRAUD-DETECTION ENVIRONMENT TEMPLATE (.env.example)
# ==============================================================================

# FastApi Service Port
PORT=8000

# Kafka Broker & Topic
KAFKA_BOOTSTRAP_SERVERS=localhost:9094
KAFKA_TOPIC=transaction-events

# Redis Cache / Storage
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=1

# Risk Evaluation Thresholds
HIGH_VALUE_THRESHOLD=50000000
MAX_TX_PER_MINUTE=5
