# ==============================================================================
# WALLET-PAYMENT ENVIRONMENT TEMPLATE (.env.example)
# ==============================================================================

# Server REST Port
PORT=8084

# VNPay Sandbox Gateway Configuration
VNPAY_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:8080/api/v1/payments/VNPAY/return
VNPAY_TMN_CODE=your_vnpay_tmn_code_here
VNPAY_SECRET_KEY=your_vnpay_secret_key_here
VNPAY_VERSION=2.1.0
VNPAY_COMMAND=pay
VNPAY_EXPIRE_MINUTES=15

# Eureka Service Discovery
EUREKA_SERVER_URL=http://localhost:8761/eureka/
