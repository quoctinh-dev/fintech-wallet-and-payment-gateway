# ==============================================================================
# WALLET-NOTIFICATION ENVIRONMENT TEMPLATE (.env.example)
# ==============================================================================

# Database Configuration (PostgreSQL 15)
DB_HOST=localhost
DB_PORT=15433
DB_NAME=wallet_notification_db
DB_USERNAME=postgres
DB_PASSWORD=your_postgres_password_here

# Kafka Message Broker
KAFKA_BOOTSTRAP_SERVERS=localhost:9094

# Brevo (Sendinblue) Email Service
BREVO_API_KEY=your_brevo_api_key_here
BREVO_SENDER_EMAIL=your_sender_email@domain.com
BREVO_SENDER_NAME=Fintech Wallet System

# Eureka Service Discovery
EUREKA_SERVER_URL=http://localhost:8761/eureka/
